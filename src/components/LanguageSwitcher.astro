---
import { locales, localeNames, localeFlags, type Locale } from '../i18n/ui';
import { withBase } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Caminho sem o prefixo de idioma, ex.: "writeups/flagyard/snaparchive/" */
  pathWithoutLocale: string;
}
const { locale, pathWithoutLocale } = Astro.props;
---

<div class="lang-switcher" role="group" aria-label="Idioma / Language / Idioma">
  {
    locales.map((l) => (
      <a
        href={withBase(`/${l}/${pathWithoutLocale}`)}
        class={l === locale ? 'active' : ''}
        aria-current={l === locale ? 'true' : undefined}
        aria-label={localeNames[l]}
        title={localeNames[l]}
      >
        <span aria-hidden="true">{localeFlags[l]}</span>
      </a>
    ))
  }
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 0.15rem;
  }
  .lang-switcher a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1.15rem;
    line-height: 1;
    filter: grayscale(65%) opacity(0.7);
    transition:
      filter 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .lang-switcher a.active {
    background: var(--color-bg-raised);
    filter: none;
  }
  .lang-switcher a:hover {
    filter: none;
    transform: translateY(-1px);
  }
</style>
