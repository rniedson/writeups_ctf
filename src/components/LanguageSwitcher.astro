---
import { locales, localeNames, type Locale } from '../i18n/ui';
import { withBase } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Caminho sem o prefixo de idioma, ex.: "writeups/flagyard/snaparchive/" */
  pathWithoutLocale: string;
}
const { locale, pathWithoutLocale } = Astro.props;
---

<div class="lang-switcher">
  {
    locales.map((l) => (
      <a
        href={withBase(`/${l}/${pathWithoutLocale}`)}
        class={l === locale ? 'active' : ''}
        aria-current={l === locale ? 'true' : undefined}
      >
        {localeNames[l]}
      </a>
    ))
  }
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 0.25rem;
    font-size: 0.85rem;
  }
  .lang-switcher a {
    padding: 0.2rem 0.5rem;
    border-radius: 0.3rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .lang-switcher a.active {
    color: var(--color-text);
    background: var(--color-bg-raised);
    font-weight: 600;
  }
  .lang-switcher a:hover {
    color: var(--color-accent);
  }
</style>
