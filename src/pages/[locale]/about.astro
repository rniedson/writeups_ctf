---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { SITE, AUTHOR } from '../../consts';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('about.title')}
  description={t('site.tagline')}
  pathWithoutLocale="about/"
>
  <article class="prose">
    <h1>{t('about.title')}</h1>
    <p>{t('site.tagline')}</p>
    <ul>
      <li>
        <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">{t('footer.sourceCode')}</a
        >
      </li>
      <li>
        {t('footer.author')}: <a href={AUTHOR.github} target="_blank" rel="noopener noreferrer"
          >{AUTHOR.name}</a
        >
      </li>
      <li><a href={AUTHOR.x} target="_blank" rel="noopener noreferrer">X (Twitter)</a></li>
      <li><a href={AUTHOR.site} target="_blank" rel="noopener noreferrer">{AUTHOR.site}</a></li>
    </ul>
  </article>
</BaseLayout>
