---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WriteupCard from '../../components/WriteupCard.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { locales, type Locale, type UiKey } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { listWriteups } from '../../lib/writeups';
import { CATEGORIES } from '../../consts';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const writeups = await listWriteups(locale);

function countBy<T>(items: T[]): Map<T, number> {
  const map = new Map<T, number>();
  for (const item of items) map.set(item, (map.get(item) ?? 0) + 1);
  return map;
}

const categoryCounts = countBy(writeups.map((w) => w.entry.data.category));
const categories = CATEGORIES.filter((c) => categoryCounts.has(c)).map((c) => ({
  value: c,
  count: categoryCounts.get(c) ?? 0,
}));

// Subcategoria: agrupada por categoria (ex.: Web > IDOR, Web > XXE, Pwn > ROP...).
const subcategoryCounts = countBy(
  writeups
    .filter((w) => w.entry.data.subcategory)
    .map((w) => `${w.entry.data.category}::${w.entry.data.subcategory}`),
);
const subcategoriesByCategory = categories
  .map((c) => ({
    category: c.value,
    items: [...subcategoryCounts.entries()]
      .filter(([key]) => key.startsWith(`${c.value}::`))
      .map(([key, count]) => ({ value: key.split('::')[1], count }))
      .sort((a, b) => a.value.localeCompare(b.value)),
  }))
  .filter((group) => group.items.length > 0);

const DIFFICULTY_ORDER = ['easy', 'medium', 'hard'] as const;
const difficultyLabelKeys: Record<(typeof DIFFICULTY_ORDER)[number], UiKey> = {
  easy: 'difficulty.easy',
  medium: 'difficulty.medium',
  hard: 'difficulty.hard',
};
const difficultyCounts = countBy(
  writeups
    .map((w) => w.entry.data.difficulty)
    .filter((d): d is NonNullable<typeof d> => Boolean(d)),
);
const difficulties = DIFFICULTY_ORDER.filter((d) => difficultyCounts.has(d)).map((d) => ({
  value: d,
  label: t(difficultyLabelKeys[d]),
  count: difficultyCounts.get(d) ?? 0,
}));

const eventCounts = countBy(writeups.map((w) => w.entry.data.event));
const events = [...eventCounts.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([value, count]) => ({ value, count }));

const authorCounts = countBy(writeups.map((w) => w.entry.data.author));
const authors = [...authorCounts.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([value, count]) => ({ value, count }));

const tagCounts = countBy(writeups.flatMap((w) => w.entry.data.tags));
const tags = [...tagCounts.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([value, count]) => ({ value, count }));

const localeTag = locale === 'pt' ? 'pt-BR' : locale;
const monthFormatter = new Intl.DateTimeFormat(localeTag, {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
const monthCounts = countBy(
  writeups.map((w) => {
    const d = w.entry.data.pubDate;
    return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  }),
);
const months = [...monthCounts.entries()]
  .sort((a, b) => b[0].localeCompare(a[0]))
  .map(([value, count]) => {
    const [year, month] = value.split('-').map(Number);
    const label = monthFormatter.format(new Date(Date.UTC(year, month - 1, 1)));
    return { value, label, count };
  });
---

<BaseLayout locale={locale} title={t('site.title')} description={t('site.tagline')}>
  <h1 class="sr-only">{t('site.title')}</h1>

  {
    writeups.length === 0 ? (
      <p>{t('writeups.empty')}</p>
    ) : (
      <div class="catalog">
        <details class="filters" open>
          <summary>{t('sidebar.filters')}</summary>
          <div class="filters-body">
            <div class="filter-group">
              <div class="search-wrap">
                <input
                  type="search"
                  id="catalog-search"
                  class="search-input"
                  placeholder={t('writeups.searchPlaceholder')}
                  aria-label={t('writeups.searchPlaceholder')}
                />
                <kbd class="search-kbd" aria-hidden="true">
                  /
                </kbd>
              </div>
            </div>

            {categories.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.category')}</legend>
                {categories.map((c) => (
                  <label class="filter-option">
                    <input type="checkbox" data-facet="category" value={c.value} />
                    <CategoryIcon category={c.value} size={13} />
                    <span>{c.value}</span>
                    <span class="filter-count">{c.count}</span>
                  </label>
                ))}
              </fieldset>
            )}

            {subcategoriesByCategory.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.subcategory')}</legend>
                {subcategoriesByCategory.map((group) => (
                  <div class="filter-subgroup">
                    <p class="filter-subgroup-label">
                      <CategoryIcon category={group.category} size={12} />
                      {group.category}
                    </p>
                    {group.items.map((sc) => (
                      <label class="filter-option filter-option-nested">
                        <input type="checkbox" data-facet="subcategory" value={sc.value} />
                        <span>{sc.value}</span>
                        <span class="filter-count">{sc.count}</span>
                      </label>
                    ))}
                  </div>
                ))}
              </fieldset>
            )}

            {difficulties.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.difficulty')}</legend>
                {difficulties.map((d) => (
                  <label class="filter-option">
                    <input type="checkbox" data-facet="difficulty" value={d.value} />
                    <span>{d.label}</span>
                    <span class="filter-count">{d.count}</span>
                  </label>
                ))}
              </fieldset>
            )}

            {events.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.event')}</legend>
                {events.map((e) => (
                  <label class="filter-option">
                    <input type="checkbox" data-facet="event" value={e.value} />
                    <span>{e.value}</span>
                    <span class="filter-count">{e.count}</span>
                  </label>
                ))}
              </fieldset>
            )}

            {authors.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.author')}</legend>
                {authors.map((a) => (
                  <label class="filter-option">
                    <input type="checkbox" data-facet="author" value={a.value} />
                    <span>{a.value}</span>
                    <span class="filter-count">{a.count}</span>
                  </label>
                ))}
              </fieldset>
            )}

            {months.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.month')}</legend>
                {months.map((m) => (
                  <label class="filter-option">
                    <input type="checkbox" data-facet="month" value={m.value} />
                    <span>{m.label}</span>
                    <span class="filter-count">{m.count}</span>
                  </label>
                ))}
              </fieldset>
            )}

            {tags.length > 0 && (
              <fieldset class="filter-group">
                <legend>{t('sidebar.tags')}</legend>
                <div class="filter-tags">
                  {tags.map((tg) => (
                    <label class="filter-option filter-option-tag">
                      <input type="checkbox" data-facet="tag" value={tg.value} />
                      <span>#{tg.value}</span>
                      <span class="filter-count">{tg.count}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}

            <button type="button" id="clear-filters" class="clear-filters">
              {t('sidebar.clear')}
            </button>
          </div>
        </details>

        <div class="catalog-main">
          <p
            id="catalog-count"
            class="catalog-count"
            data-showing-label={t('sidebar.showing')}
            data-of-label={t('sidebar.of')}
          />
          <div class="writeup-list" id="writeup-list">
            {writeups.map((w) => (
              <WriteupCard
                locale={locale}
                slug={w.slug}
                entry={w.entry}
                isFallback={w.isFallback}
              />
            ))}
          </div>
          <p id="catalog-empty" class="search-empty" hidden>
            {t('writeups.filterEmpty')}
          </p>
        </div>
      </div>
    )
  }
</BaseLayout>

<script>
  function initCatalog() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const list = document.getElementById('writeup-list');
    const emptyMsg = document.getElementById('catalog-empty');
    const countElement = document.getElementById('catalog-count');
    const clearBtn = document.getElementById('clear-filters');
    if (!list || !countElement) return;
    const countEl = countElement;

    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-search]'));
    const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[data-facet]'));
    const total = cards.length;
    const showingLabel = countEl.dataset.showingLabel ?? 'Showing';
    const ofLabel = countEl.dataset.ofLabel ?? 'of';

    function selectedByFacet(facet: string): Set<string> {
      return new Set(
        checkboxes.filter((cb) => cb.dataset.facet === facet && cb.checked).map((cb) => cb.value),
      );
    }

    function readParams() {
      const params = new URLSearchParams(location.search);
      if (searchInput) searchInput.value = params.get('q') ?? '';
      checkboxes.forEach((cb) => {
        const facet = cb.dataset.facet ?? '';
        const values = (params.get(facet) ?? '').split(',').filter(Boolean);
        cb.checked = values.includes(cb.value);
      });
    }

    function writeParams() {
      const params = new URLSearchParams();
      const q = searchInput?.value.trim() ?? '';
      if (q) params.set('q', q);
      const byFacet = new Map<string, string[]>();
      checkboxes.forEach((cb) => {
        if (!cb.checked) return;
        const facet = cb.dataset.facet ?? '';
        byFacet.set(facet, [...(byFacet.get(facet) ?? []), cb.value]);
      });
      byFacet.forEach((values, facet) => params.set(facet, values.join(',')));
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      const selectedCategory = selectedByFacet('category');
      const selectedSubcategory = selectedByFacet('subcategory');
      const selectedDifficulty = selectedByFacet('difficulty');
      const selectedEvent = selectedByFacet('event');
      const selectedAuthor = selectedByFacet('author');
      const selectedMonth = selectedByFacet('month');
      const selectedTag = selectedByFacet('tag');

      let visible = 0;
      cards.forEach((card) => {
        const matchesSearch = !query || (card.dataset.search ?? '').includes(query);
        const matchesCategory =
          selectedCategory.size === 0 || selectedCategory.has(card.dataset.category ?? '');
        const matchesSubcategory =
          selectedSubcategory.size === 0 || selectedSubcategory.has(card.dataset.subcategory ?? '');
        const matchesDifficulty =
          selectedDifficulty.size === 0 || selectedDifficulty.has(card.dataset.difficulty ?? '');
        const matchesEvent =
          selectedEvent.size === 0 || selectedEvent.has(card.dataset.event ?? '');
        const matchesAuthor =
          selectedAuthor.size === 0 || selectedAuthor.has(card.dataset.author ?? '');
        const matchesMonth =
          selectedMonth.size === 0 || selectedMonth.has(card.dataset.month ?? '');
        const cardTags = (card.dataset.tags ?? '').split(' ');
        const matchesTag =
          selectedTag.size === 0 || [...selectedTag].some((tag) => cardTags.includes(tag));
        const matches =
          matchesSearch &&
          matchesCategory &&
          matchesSubcategory &&
          matchesDifficulty &&
          matchesEvent &&
          matchesAuthor &&
          matchesMonth &&
          matchesTag;
        card.hidden = !matches;
        if (matches) visible++;
      });

      if (emptyMsg) emptyMsg.hidden = visible > 0;
      countEl.textContent = `${showingLabel} ${visible} ${ofLabel} ${total}`;
      writeParams();
    }

    readParams();
    applyFilters();

    searchInput?.addEventListener('input', applyFilters);
    checkboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      checkboxes.forEach((cb) => {
        cb.checked = false;
      });
      applyFilters();
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      const isTyping = target && ['INPUT', 'TEXTAREA'].includes(target.tagName);
      if (event.key === '/' && !isTyping) {
        event.preventDefault();
        searchInput?.focus();
      }
    });
  }
  initCatalog();
</script>

<style>
  .catalog {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .catalog {
      grid-template-columns: 260px 1fr;
    }
  }

  .filters {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
    padding: 0.9rem 1rem;
  }

  @media (min-width: 900px) {
    .filters {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  .filters summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .filters[open] summary {
    margin-bottom: 0.85rem;
  }

  .filter-group {
    border: none;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .filter-group:last-of-type {
    margin-bottom: 0.75rem;
  }

  .filter-group legend {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    font-weight: 700;
    margin-bottom: 0.4rem;
    padding: 0;
  }

  .filter-option {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .filter-option input {
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }

  .filter-subgroup {
    margin-bottom: 0.5rem;
  }

  .filter-subgroup:last-child {
    margin-bottom: 0;
  }

  .filter-subgroup-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .filter-option-nested {
    padding-left: 1.1rem;
  }

  .filter-count {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .filter-tags {
    max-height: 11rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .clear-filters {
    width: 100%;
    padding: 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.85rem;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .clear-filters:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .catalog-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0 0 1rem;
    min-height: 1.2em;
  }

  .writeup-list {
    display: grid;
    gap: 1rem;
  }
</style>
