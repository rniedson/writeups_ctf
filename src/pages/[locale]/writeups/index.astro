---
// A home virou o catálogo completo (busca + filtros por categoria/dificuldade/tema/mês),
// então esta rota só existe para não quebrar links antigos.
import { locales, type Locale } from '../../../i18n/ui';
import { localizedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
return Astro.redirect(localizedPath(locale));
---
