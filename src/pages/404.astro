---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locales, localeNames, defaultLocale } from '../i18n/ui';
import { useTranslations, localizedPath } from '../i18n/utils';

const t = useTranslations(defaultLocale);
---

<BaseLayout locale={defaultLocale} title={t('notFound.title')} description={t('notFound.body')}>
  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1>{t('notFound.title')}</h1>
    <p>{t('notFound.body')}</p>
    <p class="not-found-links">
      {
        locales.map((l) => (
          <a href={localizedPath(l)}>
            {localeNames[l]} &rarr; {t('notFound.backHome')}
          </a>
        ))
      }
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: 4rem;
    max-width: 32rem;
  }
  .not-found-code {
    font-family: var(--font-mono);
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
  }
  .not-found-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
</style>
